{
  // 采用/不采用规则的权威见 docs/standards/文档写作标准.md（「不采用的规则」表）。
  // 本配置只做「关掉不适用项」与「收窄适用范围」，不改默认集的其余规则。
  "ignores": [
    ".zcode/**",
    "node_modules/**",
    ".tmp/**"
  ],
  "config": {
    // 行长上限：中文与代码混排不适配 80 列，以段落可读性为准
    "MD013": false,
    // 代码块语言全量要求：中文话术、目录树、模板围栏无语言可标（真代码仍由文档写作规范逐条要求）
    "MD040": false,
    // 重复标题仅在同一个父级下才算违规（各阶段小节下的同名小节是合法平行结构）
    "MD024": { "siblings_only": true }
  }
}
