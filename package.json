{
  "name": "abzu-workspace",
  "private": true,
  "type": "module",
  "version": "0.0.47",
  "description": "Abzu: a long-form fiction writing workspace for DeepSeek Harness",
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "test:dsh-source": "node packages/bundle/scripts/check-dsh-source.mjs",
    "benchmark:derive": "node scripts/benchmarks/benchmark-derive.mjs",
    "benchmark:impact": "node scripts/benchmarks/benchmark-impact.mjs",
    "benchmark:search": "node --experimental-transform-types scripts/benchmarks/benchmark-search.mjs",
    "benchmark:status": "node --experimental-transform-types scripts/benchmarks/benchmark-status.mjs",
    "lint": "eslint packages scripts",
    "check:public": "node scripts/release/check-public-tree.mjs",
    "check:version": "node scripts/release/version.mjs --check",
    "test:release": "node --test scripts/release/tests/*.test.mjs",
    "release:build": "node scripts/release/build.mjs",
    "lint:fix": "eslint --fix packages scripts",
    "audit:public": "pnpm audit --audit-level=high --registry=https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "^22.0.0",
    "eslint": "9.39.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  },
  "license": "GPL-3.0-only"
}
